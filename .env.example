# ---- SWK Hub (npm start) ----
PORT=3000
DB_FILE=data/hub.db
# First boot only: the admin account. If unset, a random password is printed to the log.
ADMIN_EMAIL=admin@swkpropertiesuae.com
ADMIN_PASSWORD=change-me-now
# Set to 1 when served over HTTPS without a proxy that sends x-forwarded-proto.
COOKIE_SECURE=0

# ---- Link to SWK OS (the ERP in ./os) ----
# Address people open in the browser:
OS_URL=https://os.swk.properties
# Address Hub calls server-to-server (defaults to OS_URL):
OS_API_URL=
# SWK OS → Administration → API keys. Lets automations create OS records (os_create).
OS_API_KEY=
# Same secret as the SWK OS webhook pointing at <hub>/os/events.
OS_WEBHOOK_SECRET=

# ---- docker-compose ----
HUB_ADMIN_EMAIL=admin@swkpropertiesuae.com
HUB_ADMIN_PASSWORD=
OS_PUBLIC_URL=http://localhost:8080
